    "platform_android": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "native": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/native_projects"
          },
          "description": "Partial overrides for existing named native recipes. Names must be unique and already declared in native/native_projects. Options and GI maps merge by key; other provided fields replace the shared value."
        },
        "permissions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+$"
          },
          "description": "Additional Android manifest permissions. Runtime permission requests remain application code."
        },
        "icon": {
          "type": "string",
          "minLength": 1,
          "description": "Launcher icon image, relative to this manifest. Overrides the shared icon/desktop_icon. Converted to PNG with host GdkPixbuf."
        },
        "variant": {
          "enum": [
            "debug",
            "release"
          ],
          "default": "debug"
        },
        "module_set": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.+-]*$",
          "default": "applications-r1"
        },
        "architectures": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "arm64-v8a",
              "x86_64",
              "aarch64",
              "arm64"
            ]
          }
        },
        "format": {
          "enum": [
            "apk",
            "aab"
          ]
        },
        "min_sdk": {
          "type": "integer",
          "minimum": 31
        },
        "version_code": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2100000000
        },
        "version_name": {
          "type": "string",
          "minLength": 1
        },
        "sdk": {
          "type": "string",
          "minLength": 1
        },
        "sdk_path": {
          "type": "string",
          "minLength": 1
        },
        "runtime": {
          "enum": [
            "package",
            "source"
          ],
          "description": "Omitted: follow runtime.source/runtime.sqgi when present, otherwise use the SDK package. Explicit package overrides a shared desktop source recipe. Source builds use the pinned GNOME SDK with JIT and typed kernels disabled."
        },
        "namespaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*-[0-9]+(?:\\.[0-9]+)*$"
          }
        },
        "repository": {
          "type": "string",
          "minLength": 1,
          "description": "Ooblerg origin; releases live under /android/<sdk>/<target>/v1"
        },
        "download": {
          "type": "boolean",
          "default": true
        },
        "runner": {
          "enum": [
            "auto",
            "qemu",
            "adb"
          ]
        },
        "inspection_root": {
          "type": "string",
          "minLength": 1
        },
        "serial": {
          "type": "string",
          "minLength": 1
        },
        "enabled": {
          "type": "boolean",
          "description": "Include this platform in target all. Defaults to true. Explicit platform targets still work."
        },
        "packages": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9+.\\-]*$"
          },
          "uniqueItems": true,
          "description": "Additional packages from the pinned Android catalog. Selects a validated SDK profile containing their dependency closure."
        },
        "profile": {
          "type": "string",
          "enum": [
            "auto",
            "runtime",
            "sdk",
            "tools",
            "complete"
          ],
          "description": "Minimum SDK profile. Auto chooses the profile required by native and runtime recipes."
        }
      }
    },
