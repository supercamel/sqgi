#!/usr/bin/env sqgi

local Main = import("sqgipkg_lib/main.nut")
local args = []
foreach (arg in vargv) args.push(arg)
if (args.len() > 0 && (args[0] == "--help" || args[0] == "-h" || args[0] == "help")) {
    print(@"Usage: sqgipkg [build|check|init|explain|clean] [options]

  build                 Build the project's default package (also the default command)
  check                 Validate the manifest and selected target without building
  init [template]       Create a starter manifest (default: simple)
  explain               Show the resolved configuration without fetching or building
  clean                 Remove project build/output directories

Common options:
  --manifest FILE       Use another manifest (default: sqgipkg.json)
  --platform OS         linux or windows
  --arch ARCH           Linux architecture, e.g. x86_64 or aarch64
  --target FORMAT       appimage, win-dir, win-nsis, all
  --output DIR          Output directory
  --help-all            Full reference, including sysroot and installer options

Examples:
  sqgipkg init gtk4
  sqgipkg check
  sqgipkg build --platform windows
  sqgipkg explain
")
    return 0
}
if (args.len() > 0) {
    local command = args[0]
    if (command == "build") args.remove(0)
    else if (command == "check") args[0] = "--doctor"
    else if (command == "explain") args[0] = "--explain"
    else if (command == "clean") args[0] = "--clean"
    else if (command == "init") {
        args[0] = "--init"
        if (args.len() == 1 || args[1].slice(0, 1) == "-") args.insert(1, "simple")
    }
}
local normalized = []
for (local i = 0; i < args.len(); i++) {
    if (args[i] == "--") {
        for (; i < args.len(); i++) normalized.push(args[i])
        break
    }
    if (args[i].find("--platform=") == 0) {
        local value = args[i].slice(11)
        args[i] = "--platform"
        args.insert(i + 1, value)
    }
    if (args[i] == "--platform") {
        if (++i >= args.len()) throw "--platform requires linux or windows"
        if (args[i] != "linux" && args[i] != "windows") throw "--platform requires linux or windows"
        normalized.push("--target")
        normalized.push(args[i] == "windows" ? "windows" : "appimage")
    } else if (args[i] == "--arch") normalized.push("--appimage-arch")
    else if (args[i].find("--arch=") == 0) normalized.push("--appimage-arch=" + args[i].slice(7))
    else normalized.push(args[i])
}
local pkg = Main.SqgiPkg(normalized)
return pkg.run(normalized)
