#!/usr/bin/env sqgi

local Main = import("sqgipkg_lib/main.nut")
local args = []
foreach (arg in vargv) args.push(arg)
if (args.len() && args[0] == "android-compat") {
    args.remove(0)
    try {
        local compatibility = import("sqgipkg_lib/android/compat.nut")
        return compatibility.run(args, Main.SqgiPkg([]).long_options, __FILE__)
    } catch (error) { print("sqgipkg: " + error + "\n"); return 1 }
}
if (args.len() > 0 && (args[0] == "--help" || args[0] == "-h" || args[0] == "help")) {
    print("Usage: sqgipkg COMMAND [options]\n\n" +
          "  build                 Build the project's default package (also the default command)\n" +
          "  check                 Validate the manifest and selected target without building\n" +
          "  init [template]       Create a starter manifest (default: simple)\n" +
          "  migrate               Convert a legacy Android sqgi.json without overwriting files\n" +
          "  setup                 Check/install the Android toolchain (--platform android)\n" +
          "  emulator              Start SQGI's shared Android emulator (--headless / --stop)\n" +
          "  explain               Show the resolved configuration without fetching or building\n" +
          "  clean                 Remove project build/output directories\n" +
          "  packages              Browse searchable Ooblerg catalog metadata as JSON\n" +
          "  preview               Preview Android sources with desktop SQGI/GTK\n" +
          "  install               Install the existing Android package on a selected device\n" +
          "  deploy                Build, install and run on Android\n" +
          "  run / logs            Start the installed Android app / stream its logs\n" +
          "  sync / watch          Update scripts/assets and restart the Android app\n" +
          "  reset                 Remove source overrides and run packaged sources\n\n" +
          "Common options:\n" +
          "  --manifest FILE       Use another manifest (default: sqgipkg.json)\n" +
          "  --platform OS         linux, windows or android\n" +
          "  --arch ARCH           Architecture or Android ABI, e.g. x86_64 or arm64-v8a\n" +
          "  --serial SERIAL       Select an Android emulator or phone\n" +
          "  --help-all            Full reference, including sysroot and installer options\n\n" +
          "Examples:\n" +
          "  sqgipkg init gtk4\n" +
          "  sqgipkg setup --platform android --emulator --accept-licenses\n" +
          "  sqgipkg setup --platform android --check\n" +
          "  sqgipkg emulator\n" +
          "  sqgipkg deploy --platform android --serial emulator-5564\n")
    return 0
}
if (args.len() > 0) {
    local command = args[0]
    if (["setup", "emulator", "preview", "install", "deploy", "run", "logs", "sync", "watch", "reset"].find(command) != null) { args[0] = "--command"; args.insert(1, command) }
    else if (command == "build") args.remove(0)
    else if (command == "check") args[0] = "--doctor"
    else if (command == "packages") { args[0] = "--packages"; if (args.find("--json") == null) args.push("--json") }
    else if (command == "describe") args[0] = "--describe"
    else if (command == "explain") args[0] = "--explain"
    else if (command == "clean") args[0] = "--clean"
    else if (command == "migrate") args[0] = "--migrate-android"
    else if (command == "init") {
        args[0] = "--init"
        if (args.len() == 1 || args[1].slice(0, 1) == "-") args.insert(1, "simple")
    }
}
local normalized = []
try {
for (local i = 0; i < args.len(); i++) {
    if (args[i] == "--") {
        for (; i < args.len(); i++) normalized.push(args[i])
        break
    }
    normalized.push(args[i])
}
} catch (e) {
    if (args.find("--json") == null) throw e
    print(sqgi.json.stringify({ protocol_version = 1, ok = false, configurations = [],
        diagnostics = [{ severity = "error", code = "arguments", path = [], message = e.tostring() }] }) + "\n")
    return 1
}
local pkg = Main.SqgiPkg(normalized)
return pkg.run(normalized)
