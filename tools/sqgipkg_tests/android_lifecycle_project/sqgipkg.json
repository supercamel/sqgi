{
  "schema_version": 2,
  "name": "Android lifecycle regression",
  "app_id": "org.sqgi.NativeExit",
  "script": "main.nut",
  "compile_scripts": false,
  "features": ["gtk4"],
  "entry": {
    "type": "native", "project": "application", "executable": "lifecycle",
    "android": {"project": "application", "library": "liblifecycle.so", "symbol": "sqgi_android_main", "shutdown": "sqgi_android_shutdown"}
  },
  "native": [{"name": "application", "dir": "native", "build_system": "meson"}],
  "platforms": {"android": {"architectures": ["x86_64", "arm64-v8a"], "min_sdk": 31, "namespaces": ["Gtk-4.0"]}}
}
