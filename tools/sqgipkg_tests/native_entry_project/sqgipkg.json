{
  "schema_version": 2,
  "name": "NativeEntryProject",
  "platforms": {
    "linux": {
      "baseline": "ubuntu-24.04"
    },
    "windows": {
      "architectures": [
        "x86_64"
      ],
      "format": "installer"
    }
  },
  "entry": {
    "type": "native",
    "linux": ".sqgipkg/build/linux-x86_64/entry/sq-native-entry",
    "windows": ".sqgipkg/build/windows-x86_64/entry/sq-native-entry.exe"
  },
  "script_dirs": [
    "scripts"
  ],
  "native": [
    {
      "name": "entry",
      "dir": "native"
    }
  ],
  "linux": {
    "packages": [
      "libc6",
      "libc6-dev"
    ],
    "arches": [
      {
        "arch": "x86_64",
        "entry_linux": ".sqgipkg/build/linux-x86_64/entry/sq-native-entry"
      },
      {
        "arch": "aarch64",
        "entry_linux": ".sqgipkg/build/linux-aarch64/entry/sq-native-entry"
      }
    ]
  },
  "windows": {
    "msys2_prefix": "mingw64"
  }
}
