{
  "app_id": "org.sqgi.android.workerqualification",
  "compile_scripts": false,
  "features": [
    "gtk4"
  ],
  "files": [
    {
      "dest": "usr/share/sqgi/app/worker.nut",
      "path": "worker.nut"
    }
  ],
  "name": "Android worker qualification",
  "native": [
    {
      "build_system": "meson",
      "dir": "../../../native/android-worker",
      "gi": {
        "library": "sqgi-worker",
        "namespace": "SqWorker",
        "strategy": "target",
        "version": "1.0"
      },
      "name": "worker"
    }
  ],
  "platforms": {
    "android": {
      "architectures": [
        "x86_64",
        "arm64-v8a"
      ],
      "min_sdk": 31
    }
  },
  "schema_version": 2,
  "script": "main.nut"
}
