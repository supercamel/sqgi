{
  "schema_version": 2,
  "name": "NativeGI",
  "runtime": {
    "sqgi": "HEAD",
    "source": "../../.."
  },
  "native": [
    {
      "name": "hello",
      "dir": "native",
      "gi": {
        "strategy": "host",
        "namespace": "SqHello",
        "version": "1.0",
        "library": "sqhello-1.0"
      }
    }
  ],
  "platforms": {
    "linux": {
      "architectures": [
        "x86_64",
        "aarch64"
      ],
      "baseline": "ubuntu-24.04"
    },
    "windows": {
      "architectures": [
        "x86_64"
      ],
      "format": "installer"
    }
  },
  "windows": {
    "msys2_prefix": "mingw64"
  }
}
