{
  "schema_version": 2,
  "name": "GtkGstOverlay",
  "runtime": {
    "sqgi": "HEAD",
    "source": "../../.."
  },
  "platforms": {
    "linux": {
      "architectures": [
        "x86_64",
        "aarch64"
      ],
      "baseline": "ubuntu-24.04"
    },
    "windows": {
      "architectures": [
        "x86_64"
      ],
      "format": "installer"
    }
  },
  "features": [
    "gtk4",
    "gstreamer"
  ],
  "linux": {
    "packages": [
      "gstreamer1.0-plugins-base",
      "gstreamer1.0-plugins-good"
    ]
  },
  "windows": {
    "msys2_prefix": "mingw64"
  }
}
