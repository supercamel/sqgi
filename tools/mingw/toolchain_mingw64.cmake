set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)

set(SQGI_WINDOWS_SYSROOT "$ENV{SQGI_WINDOWS_SYSROOT}" CACHE PATH "Prepared Ooblerg SDK root")
if(NOT SQGI_WINDOWS_SYSROOT)
    message(FATAL_ERROR "Set SQGI_WINDOWS_SYSROOT to the root prepared by tools/prepare-windows-sdk.py --cross")
endif()
get_filename_component(SQGI_WINDOWS_SYSROOT "${SQGI_WINDOWS_SYSROOT}" ABSOLUTE)
set(SQGI_WINDOWS_DEPENDENCY_PREFIX "${SQGI_WINDOWS_SYSROOT}/mingw64")
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES SQGI_WINDOWS_SYSROOT)

set(TOOLCHAIN_PREFIX x86_64-w64-mingw32)

set(CMAKE_C_COMPILER   ${TOOLCHAIN_PREFIX}-gcc)
set(CMAKE_CXX_COMPILER ${TOOLCHAIN_PREFIX}-g++)
set(CMAKE_RC_COMPILER  ${TOOLCHAIN_PREFIX}-windres)

set(CMAKE_FIND_ROOT_PATH "${SQGI_WINDOWS_DEPENDENCY_PREFIX}")
set(CMAKE_PREFIX_PATH "${SQGI_WINDOWS_DEPENDENCY_PREFIX}")
set(ENV{PKG_CONFIG_PATH} "")
set(ENV{PKG_CONFIG_SYSROOT_DIR} "${SQGI_WINDOWS_SYSROOT}")
set(ENV{PKG_CONFIG_LIBDIR} "${SQGI_WINDOWS_DEPENDENCY_PREFIX}/lib/pkgconfig:${SQGI_WINDOWS_DEPENDENCY_PREFIX}/share/pkgconfig")
set(PKG_CONFIG_EXECUTABLE pkg-config CACHE FILEPATH "Host pkg-config")

set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
