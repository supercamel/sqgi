local GLib=import("GLib")
local root=GLib.path_get_dirname(GLib.canonicalize_filename(__FILE__,null))
local M={}
M.literal <- function(value){
    local result="\""
    foreach(byte in value){
        if(byte==34 || byte==92)result+="\\"+byte.tochar()
        else if(byte<32)result+=format("\\%03o",byte)
        else result+=byte.tochar()
    }
    return result+"\""
}
M.build <- function(pkg,opts,destination,name,entry){
    local compiler=pkg.host_windows()?"g++":"x86_64-w64-mingw32-g++"
    local windres=pkg.host_windows()?"windres":"x86_64-w64-mingw32-windres"
    if(!pkg.executable_available(compiler) || !pkg.executable_available(windres)){
        pkg.report_warn(opts,"Windows executable launchers require MinGW C++ and windres; using the batch launcher")
        return false
    }
    local build=GLib.dir_make_tmp("sqgipkg-launcher-XXXXXX")
    try{
        local backend=pkg.windows_effective_gdk_backend(opts),theme=pkg.windows_effective_gtk_theme(opts)
        if(backend=="")backend="win32"
        local config="// Generated by sqgipkg.\n"
        foreach(key,value in {
            SQGIPKG_ENTRY=pkg.windows_path(entry),SQGIPKG_CACHE_NAME=opts.app_id!=""?opts.app_id:name,
            SQGIPKG_GDK_BACKEND=backend,SQGIPKG_GTK_THEME=theme})
            config+="#define "+key+" L"+M.literal(value)+"\n"
        foreach(key,value in {
            SQGIPKG_SCRIPT_ENTRY=opts.entry_type=="sqgi",
            SQGIPKG_IMAGE_LOADERS=pkg.path_exists(destination+"/bin/gdk-pixbuf-query-loaders.exe"),
            SQGIPKG_SCHEMAS=pkg.path_exists(destination+"/share/glib-2.0/schemas/gschemas.compiled")})
            config+="#define "+key+" "+(value?"1":"0")+"\n"
        pkg.write_file(build+"/launcher-config.h",config)
        local resource="1 24 "+M.literal(root+"/utf8.manifest")+"\n"
        if(opts.windows.nsis_icon!="")resource+="1 ICON "+M.literal(pkg.abs_path(opts.windows.nsis_icon))+"\n"
        pkg.write_file(build+"/launcher.rc",resource)
        pkg.run_process([windres,build+"/launcher.rc","-O","coff","-o",build+"/launcher-resources.o"],"Windows launcher resources")
        foreach(console in [false,true]){
            local output=destination+"/"+name+(console?"-console":"")+".exe"
            local command=[compiler,"-std=c++17","-O2","-Wall","-Wextra","-Werror","-municode",
                "-static-libgcc","-static-libstdc++","-I",build]
            command.push(console?"-DSQGIPKG_CONSOLE":"-mwindows")
            command.extend([root+"/launcher.cpp",build+"/launcher-resources.o","-o",output,"-lshell32","-lole32"])
            pkg.run_process(command,"Windows executable launcher")
        }
        pkg.remove_tree(build)
        return true
    }catch(error){pkg.remove_tree(build);throw error}
}
return M
