<?xml version="1.0" encoding="UTF-8"?>
<!-- Opaque FreeType ABI declarations referenced by HarfBuzz introspection.
     No functions, structure layouts, or shared-library names are defined here.
     Regenerate: g-ir-compiler freetype2-2.0.gir -o freetype2-2.0.typelib
     Namespace contract: GNOME/gobject-introspection, gir/freetype2-2.0.gir. -->
<repository xmlns="http://www.gtk.org/introspection/core/1.0"
            xmlns:c="http://www.gtk.org/introspection/c/1.0" version="1.2">
  <namespace version="2.0" name="freetype2" c:symbol-prefixes="FT" c:identifier-prefixes="FT">
    <record c:type="FT_Bitmap" name="Bitmap" />
    <record c:type="FT_Face" name="Face" />
    <record c:type="FT_Library" name="Library" />
    <alias c:type="FT_Int32" name="Int32"><type name="int32" /></alias>
  </namespace>
</repository>
