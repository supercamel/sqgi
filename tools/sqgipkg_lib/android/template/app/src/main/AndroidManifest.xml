<manifest xmlns:android="http://schemas.android.com/apk/res/android">
@SQGI_PERMISSIONS@    <application android:name=".GtkApplication" android:label="@string/sqgi_app_label"@SQGI_ICON@
                 android:allowBackup="false" android:supportsRtl="true"
                 android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".GtkActivity" android:exported="true"
                  android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name="org.gtk.android.ToplevelActivity" android:exported="false"
                  android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|uiMode|density" />
@SQGI_SERVICES@    </application>
</manifest>
