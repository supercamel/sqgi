// Content identities for the selected build tools, independent of install paths.
local C = import("common.nut"), GLib = import("GLib"), Gio = import("Gio"), M = {}
M.tree <- function(root) {
    local files = {}, ancestors = [], contents = {}
    local visit = null
    visit = function(path, name) {
        // Distribution packages can contain optional links (for example the
        // JDK source archive). Record their absence instead of ignoring them.
        if (C.is_link(path) && !C.is_file(path) && !C.is_dir(path)) {
            files[name] <- { missing_link = GLib.file_read_link(path) }
            return
        }
        local info = Gio.File.new_for_path(path).query_info("standard::type,unix::mode,id::file", Gio.FileQueryInfoFlags.none, null)
        if (info.get_file_type() == Gio.FileType.directory) {
            local real = C.realpath(path)
            if (ancestors.find(real) != null) throw "Cycle in Android host tool directory: " + path
            ancestors.push(real)
            foreach (item in C.children(path)) {
                // Python bytecode is regenerated by upstream build tools.
                if (item.name == "__pycache__" || C.ends(item.name, ".pyc")) continue
                visit(item.path, name == "" ? item.name : name + "/" + item.name)
            }
            ancestors.pop()
        } else if (info.get_file_type() == Gio.FileType.regular) {
            local id = info.get_attribute_string("id::file")
            if (id == null) id = path
            if (!(id in contents)) contents[id] <- C.file_hash(path)
            files[name] <- { sha256 = contents[id], executable = (info.get_attribute_uint32("unix::mode") & 73) != 0 }
        } else throw "Unsupported Android host tool file: " + path
    }
    visit(root, "")
    return { sha256 = C.digest(C.encoded(files)), files = files.len() }
}
M.identify <- function(roots) {
    local components = {}
    foreach (name in C.keys(roots)) components[name] <- M.tree(roots[name])
    return { sha256 = C.digest(C.encoded(components)), components = components }
}
return M
