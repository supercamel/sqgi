function shared_region_100(r,x) { r.count=r.count+1; local s=0; local flag=!x; if(flag) s=s+1;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;s=s+x;return s+r.tail; }
local r100={count=0,tail=7}; if(shared_region_100(r100,2)!=207 || r100.count!=1) throw "bad 100";
