+        SQObjectPtr owners[3] = {SQObjectPtr(SQArray::Create(v->_sharedstate, 0)),
+            SQObjectPtr(SQArray::Create(v->_sharedstate, 0)),
+            SQObjectPtr(SQArray::Create(v->_sharedstate, 0))};
+        SQObjectPtr slot(owners[0]); v->temp_reg = owners[1];
