+    }
+    {
+        SQObjectPtr slot(SQString::Create(v->_sharedstate, _SC("private-self-observed")));
+        SQObjectPtr weak(_refcounted(slot)->GetWeakRef(OT_STRING));
+        {
+            SQJitWriteLog log;
