+static void native_call_frame_cleanup()
+{
+    for(bool enabled : {false, true}) for(bool tail : {false, true}) for(int locals : {8,16,24}) {
+        SQVM *v = sq_open(64);
+        SQJitContext &ctx = sqjit_context(v->_sharedstate);
