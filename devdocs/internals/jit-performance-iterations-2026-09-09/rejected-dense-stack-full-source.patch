+    uint32_t *index = NULL;
+    if(_stack_indices) {
+        const uintptr_t offset = (uintptr_t)slot - (uintptr_t)_stack_base;
+        if(offset < _stack_count * sizeof(SQObjectPtr) && offset % sizeof(SQObjectPtr) == 0)
+            index = &_stack_indices[offset / sizeof(SQObjectPtr)];
+        else if(slot == _stack_temporary) index = &_stack_indices[_stack_count];
+    }
+    if(index) {
+        if(*index > _value_epoch && *index <= _value_size) {
+            const ValueEntry &saved = _values[*index - 1];
+            assert(saved.slot == slot);
+            if(sq_type(saved.value) == sq_type(*slot) && _rawval(saved.value) == _rawval(*slot))
+                return true;
+            return RetainValue(*slot);
+        }
+        // BindStack precedes every append, and all writes to this span pass
+        // here. No entry in the current epoch can exist without its index.
+        // Publish only after allocation succeeds; entry indices survive growth.
+        if(!AppendValue(slot, *slot)) return false;
+        *index = (uint32_t)_value_size;
+        return true;
+    }
+    if(!EnsureValueIndex()) return false;
+    const ValueEntry *saved = FindValue<true>(slot, *slot);
+    if(saved) {
+        // The first snapshot restores the slot. Additional displaced owners
+        // only need lifetime pins, not another copy of its rollback address.
+        if(sq_type(saved->value) == sq_type(*slot) &&
+            _rawval(saved->value) == _rawval(*slot)) return true;
+        return RetainValue(*slot);
