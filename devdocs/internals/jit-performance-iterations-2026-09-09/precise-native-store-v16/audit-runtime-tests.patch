+                !sqjit_a64_patch_branch(buf,is_float,buf->size,true,SQ_JIT_A64_EQ) ||
+                !sqjit_a64_emit_ldr_float(buf,fp,19,sqjit_a64_stack_value_disp(slot)) ||
