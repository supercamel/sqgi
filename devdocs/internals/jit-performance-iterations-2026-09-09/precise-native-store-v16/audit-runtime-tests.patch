+        SQVM *child = nested_vm;
+        nested_vm = NULL;
+        SQJitContext &ctx = sqjit_context(closure->_function->_sharedstate);
+        SQVM *outer = ctx.active_vm;
+        nested_ok = run(child, _SC("if(resume_work(shared_array,4)!=14) throw \"nested resume\";")) &&
+            ctx.active_vm == outer;
