+        literal_bits = (SQInteger)_rawval(proto->_literals[i._arg1]); break;
+    case _OP_LOADINT: literal_bits = sqjit_loadint_value(i); break;
+    case _OP_LOADBOOL: literal_type = OT_BOOL; literal_bits = i._arg1 != 0; break;
+    case _OP_LOADFLOAT: {
