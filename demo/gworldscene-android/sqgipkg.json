{
  "schema_version": 2,
  "name": "Alpine",
  "app_id": "org.sqgi.demo.alpine",
  "script": "src/main.nut",
  "script_dirs": ["src"],
  "compile_scripts": false,
  "features": ["gtk4"],
  "icon": "assets/icon.svg",
  "files": [{"src": "assets", "dest": "usr/share/sqgi/app/assets"}],
  "native": [{"name": "gworldscene", "android_package": "extras-gworldscene"}],
  "platforms": {
    "android": {
      "architectures": ["x86_64", "arm64-v8a"],
      "min_sdk": 31,
      "sdk": "noble-android-r7",
      "repository": "https://ooblerg.xyz",
      "permissions": ["android.permission.INTERNET"],
      "version_code": 1,
      "version_name": "1.0.0"
    }
  }
}
