// Four-neighbour, unit-cost A* on a fixed 16x16 grid. 0=free, 1=blocked.
// An intentionally simple linear open-set scan keeps the prototype readable.
// Return path node count, or -1 if unreachable. Path is goal -> start.
struct Search { i64 g; i64 f; i64 parent; i64 status; };
i64 distance(i64 a, i64 b) {
    i64 ar = a / 16;
    i64 br = b / 16;
    i64 dx = (a - ar * 16) - (b - br * 16);
    i64 dy = ar - br;
    if (dx < 0) { dx = -dx; }
    if (dy < 0) { dy = -dy; }
    return dx + dy;
}
export i64 search(in i64 grid[256], inout Search state[256], inout i64 path[256],
                  i64 start, i64 goal) {
    require(start >= 0 && start < 256 && goal >= 0 && goal < 256);
    for (i64 i = 0; i < 256; i += 1) {
        require(grid[i] == 0 || grid[i] == 1);
        state[i].g = 1000000;
        state[i].f = 1000000;
        state[i].parent = -1;
        state[i].status = 0;
        path[i] = -1;
    }
    if (grid[start] != 0 || grid[goal] != 0) { return -1; }
    state[start].g = 0;
    state[start].f = distance(start, goal);
    state[start].status = 1;
    while (true) {
        i64 current = -1;
        i64 best = 1000000;
        for (i64 i = 0; i < 256; i += 1) {
            if (state[i].status == 1 && state[i].f < best) {
                best = state[i].f;
                current = i;
            }
        }
        if (current == -1) { return -1; }
        if (current == goal) {
            i64 length = 0;
            while (current != -1) {
                path[length] = current;
                length += 1;
                current = state[current].parent;
            }
            return length;
        }
        state[current].status = 2;
        i64 row = current / 16;
        i64 col = current - row * 16;
        for (i64 direction = 0; direction < 4; direction += 1) {
            i64 nr = row;
            i64 nc = col;
            if (direction == 0) { nr -= 1; }
            if (direction == 1) { nr += 1; }
            if (direction == 2) { nc -= 1; }
            if (direction == 3) { nc += 1; }
            if (nr >= 0 && nr < 16 && nc >= 0 && nc < 16) {
                i64 next = nr * 16 + nc;
                if (grid[next] == 0 && state[next].status != 2) {
                    i64 candidate = state[current].g + 1;
                    if (candidate < state[next].g) {
                        state[next].g = candidate;
                        state[next].f = candidate + distance(next, goal);
                        state[next].parent = current;
                        state[next].status = 1;
                    }
                }
            }
        }
    }
    return -1;
}
